# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data — too large for git, rebuilt by download_*.py + build_*.py.
# The manifest is tracked so that a rebuild can be verified: see verify_data.py.
data/*
!data/processed_manifest.json
*.npz
*.npy

# Trained checkpoints ARE tracked. They were excluded here as "too large", but
# all 39 of them come to 297 KB against a 29.7 MB repository -- and repo results
# load them (ptq_full_eval.py, compute_agreement.py, build_deploy_firmware.py),
# so without them a clone cannot regenerate ptq_full_multiseed.json,
# agreement_5seed.json, or the deployed model_weights.h.

# LaTeX build artifacts (keep .tex, .bib, figures/*.pdf, and main.pdf)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Arduino / CCS build outputs
*.elf
*.hex
*.bin
*.o
Debug/
Release/
.cproject
.project
.metadata/
*.launch
.worktrees/

# Misc
*.tmp
*.bak
*.log

# Experiment stderr. The .json result files next to these are the record;
# these only hold progress bars and warnings from the run that produced them.
experiments/*.err
_drift_logs/
_pruned_v2_logs/

# Local working documents and submission bundles
*.docx
*.tar.gz

# CCS / Theia debug session noise (workspace lock files, output traces)
true
contract.md

# firmware build artifacts
arduino/*/host_main.cpp
arduino/*/host_test.exe
arduino/*/test_data.h
# deploy_*_hapt_s*.pt is NOT an artifact: build_deploy_firmware.py loads it
# instead of retraining, so it is the provenance of the flashed weights.
